# NutriVision AI - Environment Variables
# Copy this file to .env and add your API keys

# Groq API Key
# Get your key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Groq chat model (optional; default: qwen/qwen3.8-27b)
# Models available to your key: https://console.groq.com/docs/models
GROQ_MODEL=qwen/qwen3.8-27b

# Flask Configuration
FLASK_SECRET_KEY=your_secret_key_here
FLASK_ENV=development
# Enables the Flask debugger and auto-reload; never use True on a shared network
FLASK_DEBUG=False


